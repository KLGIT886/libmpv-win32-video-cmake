+/*
+ * Weave gate tolerance, in 8-bit code units scaled by the sample depth.
+ * The reference gate is "diff == 0", so any per-frame encoder ringing on
+ * static high-frequency detail (a channel logo, for instance) is treated as
+ * motion and re-interpolated spatially, which flickers at field rate.
+ * Treating small differences as still makes such detail weave both fields
+ * again. 10 codes matches rtp2httpd's hand-written bwdif shader.
+ */
+#define BWDIF_WEAVE_TOL(clip_max) (10 * (((clip_max) + 1) >> 8))
 
